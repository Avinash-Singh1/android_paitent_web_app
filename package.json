{
  "name": "nectar",
  "version": "3.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4400 --host localhost --ssl=false --proxy-config proxy.conf.json",
    "build": "ng build && node scripts/postbuild-manifest.js",
    "build:ssr": "ng build && node scripts/postbuild-manifest.js",
    "serve:ssr": "NG_ALLOWED_HOSTS=localhost node dist/nectar/server/server.mjs",
    "test": "ng test",
    "dev": "ng serve --port 4400 --host localhost",
    "postinstall": "node scripts/patch-angular-build.js",
    "zip-build": "node zip-build.js",
    "version:replace": "replace npm_version %npm_package_version% .elasticbeanstalk/config.yml",
    "version:return": "replace %npm_package_version% npm_version .elasticbeanstalk/config.yml"
  },
  "exports": {
    ".": {
      "sass": "./styles/*.scss"
    }
  },
  "private": true,
