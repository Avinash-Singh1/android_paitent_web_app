{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "nectar": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "nectar",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "allowedCommonJsDependencies": [
              "moment",
              "ngx-csv",
              "slugify",
              "crypto-js",
              "twilio-video"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "src/styles",
                "src/styles/tools",
                "src/styles/settings",
                "src/styles/scss"
              ]
            },
            "polyfills": [
              "zone.js"
            ],
            "outputPath": "dist/nectar",
            "index": "src/index.html",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "browser": "src/main.ts",
            "assets": [
              "src/favicon.ico",
              "src/assets",
              "src/robots.txt",
              "src/styles",
              {
                "input": "src/styles",
                "glob": "**/*.scss",
                "output": "styles"
              }
            ],
            "styles": [
              "src/styles.scss",
              {
                "input": "./node_modules/bootstrap/dist/css/bootstrap.min.css",
                "inject": true,
                "bundleName": "lazy-styles"
              },
              {
                "input": "./node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
                "inject": true,
                "bundleName": "lazy-styles"
              },
              {
                "input": "./node_modules/ngx-toastr/toastr.css",
                "inject": true,
                "bundleName": "lazy-styles"
              },
              {
                "input": "node_modules/ngx-owl-carousel-o/lib/styles/prebuilt-themes/owl.carousel.min.css",
                "inject": true,
                "bundleName": "lazy-styles"
              },
              {
                "input": "node_modules/ngx-owl-carousel-o/lib/styles/prebuilt-themes/owl.theme.default.min.css",
                "inject": true,
                "bundleName": "lazy-styles"
              }
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "server": "src/main.server.ts",
              "ssr": {
                "entry": "server.ts"
              },
              "outputMode": "server",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "3mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "40kb",
                  "maximumError": "1mb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all",
              "aot": true,
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": true
                },
                "fonts": true
              }
            },
            "staging": {
              "server": "src/main.server.ts",
              "ssr": {
                "entry": "server.ts"
              },
              "outputMode": "server",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "20kb",
                  "maximumError": "1mb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.stag.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "ssl": true,
            "sslCert": ".ssl/cert.pem",
            "sslKey": ".ssl/key.pem"
          },
          "configurations": {
            "production": {
              "buildTarget": "nectar:build:production"
            },
            "development": {
              "buildTarget": "nectar:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "nectar:build"
          }
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "main": "src/test.ts",
            "polyfills": "src/polyfills.ts",
            "tsConfig": "tsconfig.spec.json",
            "karmaConfig": "karma.conf.js",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "@angular/material/prebuilt-themes/indigo-pink.css",
              "src/styles.scss"
            ],
            "scripts": []
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "93c53c1a-4115-4396-bfaa-b9c3c2cf09a2",
    "cache": {
      "enabled": true
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}